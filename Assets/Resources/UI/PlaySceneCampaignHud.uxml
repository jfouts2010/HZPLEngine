<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="PlaySceneCampaignHud.uss" />
    <ui:VisualElement name="campaign-hud-root" class="campaign-hud-root" picking-mode="Ignore">
        <ui:VisualElement name="campaign-hud-panel" class="campaign-hud-panel" picking-mode="Position" style="width: 320px; padding-left: 14px; padding-right: 14px; padding-top: 12px; padding-bottom: 12px; background-color: rgba(18, 20, 23, 0.86); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;">
            <ui:Label name="campaign-title" text="Campaign" class="campaign-hud-title" style="color: white; font-size: 18px; -unity-font-style: bold; margin-bottom: 6px;" />
            <ui:Label name="campaign-time" text="Time" class="campaign-hud-text" style="color: white; font-size: 13px; margin-bottom: 6px;" />
            <ui:Label name="selected-tile" text="Select a hex" class="campaign-hud-text campaign-hud-selection" style="color: white; font-size: 13px; margin-bottom: 6px; white-space: normal;" />
            <ui:Button name="pause-button" text="Pause" class="campaign-hud-button" style="height: 28px; margin-top: 10px; background-color: rgb(54, 86, 142); color: white; border-width: 0;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
