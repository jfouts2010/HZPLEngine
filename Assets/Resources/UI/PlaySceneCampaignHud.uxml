<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="PlaySceneCampaignHud.uss" />
    <ui:VisualElement name="campaign-hud-root" class="workbench" picking-mode="Ignore">
        <ui:VisualElement name="workbench-topbar" class="workbench-topbar" picking-mode="Position">
            <ui:VisualElement class="workbench-brand">
                <ui:Label name="campaign-title" text="Campaign Debug Workbench" class="workbench-title" />
                <ui:Label name="campaign-time" text="Time" class="workbench-time" />
            </ui:VisualElement>
            <ui:VisualElement name="simulation-controls" class="simulation-controls">
                <ui:Label name="simulation-state-label" text="SIMULATION PAUSED" class="simulation-state-label simulation-state-label--paused" />
                <ui:Button name="speed-5s-button" text="5 SEC" class="workbench-button simulation-speed-button simulation-speed-button--selected" />
                <ui:Button name="speed-5m-button" text="5 MIN" class="workbench-button simulation-speed-button" />
                <ui:Button name="pause-button" text="Play" class="workbench-button workbench-button--primary" />
                <ui:Button name="next-increment-button" text="Next +5s" class="workbench-button" />
            </ui:VisualElement>
            <ui:VisualElement class="diagnostic-strip">
                <ui:Label text="DIAGNOSTICS" class="diagnostic-strip-label" />
                <ui:Button name="diagnostics-errors-button" text="Errors 0" class="diagnostic-chip diagnostic-chip--error" />
                <ui:Button name="diagnostics-warnings-button" text="Warnings 0" class="diagnostic-chip diagnostic-chip--warning" />
                <ui:Button name="reset-layout-button" text="Reset Layout" class="workbench-button workbench-button--quiet" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="workbench-body" picking-mode="Ignore">
            <ui:VisualElement class="workbench-nav" picking-mode="Position">
                <ui:Button name="map-tab-button" text="TILE" class="workbench-nav-button workbench-nav-button--selected" />
                <ui:Button name="ground-tab-button" text="GROUND" class="workbench-nav-button" />
                <ui:Button name="air-ops-tab-button" text="AIR" class="workbench-nav-button" />
                <ui:Button name="turn-tab-button" text="LAST TURN" class="workbench-nav-button" />
                <ui:Button name="diagnostics-tab-button" text="DIAGNOSTICS" class="workbench-nav-button" />
                <ui:Button name="toggle-panel-button" text="HIDE PANEL" class="workbench-nav-button workbench-nav-button--utility" />
            </ui:VisualElement>

            <ui:VisualElement name="campaign-hud-panel" class="workbench-panel" picking-mode="Position">
                <ui:VisualElement class="workbench-panel-header">
                    <ui:VisualElement>
                        <ui:Label text="PRIMARY INSPECTOR" class="workbench-kicker" />
                        <ui:Label name="workbench-page-title" text="Tile Inspector" class="workbench-panel-title" />
                    </ui:VisualElement>
                    <ui:Button name="pin-primary-button" text="Pin" class="workbench-button workbench-button--small" />
                </ui:VisualElement>

                <ui:ScrollView name="map-info-content" class="workbench-scroll">
                    <ui:Label name="selected-tile" text="Select a tile" class="selection-summary" />
                    <ui:Foldout name="neighbors-foldout" text="Neighbors" class="workbench-foldout">
                        <ui:VisualElement name="neighbors-list" class="dense-list" />
                    </ui:Foldout>
                    <ui:Foldout name="units-foldout" text="Units" class="workbench-foldout" value="true">
                        <ui:VisualElement name="units-list" class="dense-list" />
                    </ui:Foldout>
                    <ui:Foldout name="buildings-foldout" text="Buildings" class="workbench-foldout" value="true">
                        <ui:VisualElement name="buildings-list" class="dense-list" />
                    </ui:Foldout>
                </ui:ScrollView>

                <ui:ScrollView name="ground-ops-content" class="workbench-scroll workbench-page--hidden">
                    <ui:Label text="ACTIVE GROUND COMBATS" class="workbench-kicker" />
                    <ui:Label name="ground-ops-summary" text="No active combats." class="workbench-summary" />
                    <ui:VisualElement name="ground-combats-list" class="dense-list" />
                </ui:ScrollView>

                <ui:ScrollView name="air-ops-content" class="workbench-scroll workbench-page--hidden">
                    <ui:Label text="AIR OPERATIONS PICTURE" class="workbench-kicker" />
                    <ui:Label name="air-ops-summary" text="Air operations" class="workbench-summary" />
                    <ui:VisualElement class="stat-grid">
                        <ui:VisualElement class="stat-tile"><ui:Label name="air-request-count" text="0" class="stat-value" /><ui:Label text="REQUESTS" class="stat-label" /></ui:VisualElement>
                        <ui:VisualElement class="stat-tile"><ui:Label name="air-package-count" text="0" class="stat-value" /><ui:Label text="PACKAGES" class="stat-label" /></ui:VisualElement>
                        <ui:VisualElement class="stat-tile"><ui:Label name="air-airborne-count" text="0" class="stat-value" /><ui:Label text="AIRBORNE" class="stat-label" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="air-overview-grid" class="air-overview-grid" />
                    <ui:VisualElement class="segmented-control">
                        <ui:Button name="air-requests-button" text="Requests" class="segment" />
                        <ui:Button name="air-packages-button" text="Packages" class="segment" />
                        <ui:Button name="air-flights-button" text="Flights" class="segment" />
                        <ui:Button name="air-passes-button" text="Ordnance" class="segment" />
                    </ui:VisualElement>
                    <ui:Label name="air-inspection-status" text="" class="inspection-status" />
                    <ui:Label name="air-list-title" text="CURRENT FLIGHTS" class="table-title" />
                    <ui:VisualElement name="air-alliance-filter" class="segmented-control">
                        <ui:Button name="air-blue-flights-button" text="Blue" class="segment segment--blue segment--selected" />
                        <ui:Button name="air-red-flights-button" text="Red" class="segment segment--red" />
                    </ui:VisualElement>
                    <ui:VisualElement name="air-requests-list" class="dense-list campaign-air-list--hidden" />
                    <ui:VisualElement name="air-packages-list" class="dense-list campaign-air-list--hidden" />
                    <ui:VisualElement name="air-flights-list" class="dense-list" />
                    <ui:VisualElement name="air-passes-list" class="dense-list campaign-air-list--hidden" />
                </ui:ScrollView>

                <ui:ScrollView name="turn-report-content" class="workbench-scroll workbench-page--hidden">
                    <ui:Label text="LAST COMPLETED TURN" class="workbench-kicker" />
                    <ui:Label name="turn-report-summary" text="Advance one turn to generate a report." class="workbench-summary" />
                    <ui:VisualElement name="turn-report-list" class="dense-list" />
                </ui:ScrollView>

                <ui:VisualElement name="diagnostics-content" class="workbench-page workbench-page--hidden">
                    <ui:VisualElement class="filter-row">
                        <ui:TextField name="diagnostics-search" label="Search" class="filter-search" />
                        <ui:DropdownField name="diagnostics-severity" label="Severity" class="filter-dropdown" />
                        <ui:DropdownField name="diagnostics-system" label="System" class="filter-dropdown" />
                    </ui:VisualElement>
                    <ui:ScrollView class="workbench-scroll workbench-scroll--nested">
                        <ui:VisualElement name="diagnostics-list" class="dense-list" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="panel-resize-handle" class="panel-resize-handle" />
            </ui:VisualElement>

            <ui:VisualElement name="overlay-palette" class="overlay-palette" picking-mode="Position">
                <ui:Label text="VIEW PERSPECTIVE" class="workbench-kicker" />
                <ui:VisualElement name="perspective-controls" class="perspective-controls">
                    <ui:Button name="perspective-observer-button" text="Observer" class="perspective-button perspective-button--selected" />
                    <ui:Button name="perspective-blue-button" text="Blue" class="perspective-button perspective-button--blue" />
                    <ui:Button name="perspective-red-button" text="Red" class="perspective-button perspective-button--red" />
                </ui:VisualElement>
                <ui:Label text="MAP OVERLAYS" class="workbench-kicker" />
                <ui:Toggle name="overlay-units-toggle" text="Division counters" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-combats-toggle" text="Combat bubbles" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-movement-toggle" text="Ground movement" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-routes-toggle" text="Flight routes" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-barriers-toggle" text="BARCAP barriers" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-territory-boundaries-toggle" text="Territory boundaries" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-sam-toggle" text="SAM sites &amp; ranges" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-ordnance-toggle" text="Ordnance markers" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-rail-toggle" text="Railways" value="true" class="overlay-toggle" />
                <ui:Toggle name="overlay-air-control-toggle" text="Air interference" class="overlay-toggle" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="window-layer" class="window-layer" picking-mode="Ignore">
            <ui:VisualElement name="flight-detail-backdrop" class="floating-window-host" picking-mode="Ignore">
                <ui:VisualElement name="flight-detail-popup" class="floating-window floating-window--flight" picking-mode="Position">
                    <ui:VisualElement name="flight-detail-drag-handle" class="floating-window-header">
                        <ui:VisualElement class="floating-window-heading">
                            <ui:Label text="FLIGHT INSPECTOR" class="workbench-kicker" />
                            <ui:Label name="flight-detail-title" text="Flight" class="floating-window-title" />
                            <ui:Label name="flight-detail-subtitle" text="Mission" class="floating-window-subtitle" />
                        </ui:VisualElement>
                        <ui:Button name="flight-detail-focus" text="Focus" class="workbench-button workbench-button--small" />
                        <ui:Button name="flight-detail-pin" text="Pin" class="workbench-button workbench-button--small" />
                        <ui:Button name="flight-detail-close" text="×" class="window-close" />
                    </ui:VisualElement>
                    <ui:ScrollView name="flight-detail-scroll" class="floating-window-scroll">
                        <ui:VisualElement name="flight-detail-content" />
                    </ui:ScrollView>
                    <ui:VisualElement name="flight-detail-resize-handle" class="window-resize-handle" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
