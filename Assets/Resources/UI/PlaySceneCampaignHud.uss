.campaign-hud-root {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
    padding-top: 16px;
    padding-right: 16px;
}

.campaign-hud-panel {
    width: 320px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(18, 20, 23, 0.86);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.campaign-hud-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.campaign-hud-text {
    color: white;
    font-size: 13px;
    margin-bottom: 6px;
}

.campaign-hud-selection {
    white-space: normal;
}

.campaign-hud-button {
    height: 28px;
    margin-top: 10px;
    background-color: rgb(54, 86, 142);
    color: white;
    border-width: 0;
}

.campaign-hud-button:hover {
    background-color: rgb(70, 108, 174);
}

.campaign-hud-button:active {
    background-color: rgb(38, 63, 109);
}

.campaign-hud-foldout {
    color: white;
    font-size: 13px;
}

.campaign-hud-foldout > .unity-foldout__toggle {
    color: white;
}

.campaign-hud-neighbors-list {
    flex-direction: column;
    margin-left: 8px;
    margin-top: 4px;
}

.campaign-hud-neighbor-item {
    height: 24px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    color: white;
    font-size: 12px;
    border-width: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.campaign-hud-neighbor-item:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.campaign-hud-neighbor-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    margin-bottom: 2px;
    white-space: normal;
}

.campaign-hud-units-list {
    flex-direction: column;
    margin-left: 8px;
    margin-top: 4px;
}

.campaign-hud-unit-card {
    flex-direction: column;
    margin-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    border-left-width: 3px;
    border-left-color: rgb(160, 170, 185);
}

.campaign-hud-unit-name {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.campaign-hud-unit-stat {
    color: rgba(255, 255, 255, 0.78);
    font-size: 11px;
    margin-top: 2px;
}
