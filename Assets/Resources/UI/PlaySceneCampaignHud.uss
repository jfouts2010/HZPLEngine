.campaign-hud-root {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
    padding-top: 16px;
    padding-right: 16px;
}

.campaign-hud-panel {
    width: 360px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    background-color: rgba(18, 20, 23, 0.86);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.simulation-controls {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 244px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 11px;
    background-color: rgba(18, 20, 23, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.14);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-top-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.14);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.simulation-state-label {
    height: 18px;
    flex-shrink: 0;
    margin-bottom: 6px;
    color: rgb(121, 207, 141);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.simulation-state-label--paused {
    color: rgb(235, 196, 103);
}

.simulation-control-buttons {
    flex-direction: row;
    height: 34px;
    flex-shrink: 0;
}

.simulation-control-button {
    flex-grow: 1;
    height: 32px;
    margin-right: 6px;
    color: white;
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 0;
}

.simulation-control-button--primary {
    background-color: rgb(54, 86, 142);
}

.simulation-control-button:hover {
    background-color: rgb(70, 108, 174);
}

.simulation-control-button:disabled {
    color: rgba(255, 255, 255, 0.32);
    background-color: rgba(255, 255, 255, 0.05);
}

.campaign-hud-panel--air-ops {
    width: 540px;
}

.campaign-hud-tabs {
    flex-direction: row;
    margin-top: 2px;
    margin-bottom: 8px;
}

.campaign-hud-tab {
    flex-grow: 1;
    height: 27px;
    margin-right: 3px;
    background-color: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.72);
    border-width: 0;
}

.campaign-hud-tab--selected {
    background-color: rgb(54, 86, 142);
    color: white;
}

.campaign-air-ops-content {
    display: none;
    height: 610px;
    flex-shrink: 0;
}

.campaign-air-ops-content .unity-scroll-view__vertical-scroller,
.flight-detail-scroll .unity-scroll-view__vertical-scroller {
    width: 15px;
    background-color: rgba(0, 0, 0, 0.28);
}

.campaign-air-ops-content .unity-base-slider__tracker,
.flight-detail-scroll .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.10);
}

.campaign-air-ops-content .unity-base-slider__dragger,
.flight-detail-scroll .unity-base-slider__dragger {
    min-height: 38px;
    background-color: rgb(104, 133, 173);
    border-left-color: rgb(142, 171, 210);
    border-right-color: rgb(142, 171, 210);
    border-top-color: rgb(142, 171, 210);
    border-bottom-color: rgb(142, 171, 210);
}

.campaign-air-ops-summary {
    color: rgba(255, 255, 255, 0.82);
    font-size: 13px;
    margin-bottom: 10px;
    white-space: normal;
}

.campaign-air-section-kicker {
    color: rgb(113, 168, 239);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.campaign-air-stats {
    flex-direction: row;
    margin-bottom: 13px;
}

.campaign-air-stat {
    flex-grow: 1;
    margin-right: 6px;
    padding-top: 8px;
    padding-bottom: 7px;
    background-color: rgba(255, 255, 255, 0.07);
    align-items: center;
}

.campaign-air-stat-value {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
}

.campaign-air-stat-label {
    color: rgba(255, 255, 255, 0.55);
    font-size: 9px;
    letter-spacing: 1px;
}

.campaign-air-list {
    flex-direction: column;
    margin-left: 0;
    margin-top: 6px;
    margin-bottom: 9px;
}

.campaign-air-list--hidden {
    display: none;
}

.campaign-air-view-tabs {
    flex-direction: row;
    margin-bottom: 12px;
}

.campaign-air-view-tab {
    flex-grow: 1;
    height: 34px;
    margin-right: 5px;
    background-color: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.72);
    border-width: 0;
}

.campaign-air-view-tab--selected {
    background-color: rgb(54, 86, 142);
    color: white;
}

.campaign-air-list-title {
    height: 22px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.campaign-air-alliance-filter {
    flex-direction: row;
    height: 36px;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.campaign-air-alliance-filter--hidden {
    display: none;
}

.campaign-air-alliance-tab {
    flex-grow: 1;
    height: 32px;
    margin-right: 6px;
    color: rgba(255, 255, 255, 0.72);
    background-color: rgba(255, 255, 255, 0.07);
    border-width: 0;
}

.campaign-air-alliance-tab--blue.campaign-air-alliance-tab--selected {
    color: white;
    background-color: rgb(47, 101, 177);
}

.campaign-air-alliance-tab--red.campaign-air-alliance-tab--selected {
    color: white;
    background-color: rgb(154, 56, 55);
}

.campaign-air-card {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    flex-shrink: 0;
    min-height: 150px;
    margin-bottom: 8px;
    padding-left: 11px;
    padding-right: 11px;
    padding-top: 9px;
    padding-bottom: 9px;
    background-color: rgba(255, 255, 255, 0.08);
    border-left-width: 3px;
    border-left-color: rgb(145, 155, 170);
}

.campaign-air-card--clickable {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-left;
}

.campaign-air-card--clickable:hover {
    background-color: rgba(90, 139, 204, 0.22);
}

.campaign-air-card--blue {
    border-left-color: rgb(76, 139, 231);
}

.campaign-air-card--red {
    border-left-color: rgb(220, 77, 70);
}

.campaign-air-card-title {
    height: 26px;
    flex-shrink: 0;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.campaign-air-card-detail {
    min-height: 110px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    margin-top: 5px;
    line-height: 16px;
    white-space: normal;
}

.campaign-air-field-row {
    flex-direction: row;
    flex-shrink: 0;
    min-height: 22px;
    margin-top: 1px;
}

.campaign-air-field-label {
    width: 112px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.48);
    font-size: 11px;
}

.campaign-air-field-value {
    flex-grow: 1;
    color: rgba(255, 255, 255, 0.86);
    font-size: 12px;
    white-space: normal;
}

.campaign-air-help {
    color: rgba(255, 255, 255, 0.48);
    font-size: 11px;
    margin-top: 5px;
    margin-bottom: 5px;
    -unity-text-align: middle-center;
}

.campaign-air-inspection-status {
    display: none;
    min-height: 28px;
    flex-shrink: 0;
    margin-top: 3px;
    margin-bottom: 7px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    color: rgb(232, 202, 118);
    background-color: rgba(153, 112, 34, 0.20);
    font-size: 11px;
    white-space: normal;
}

.campaign-air-inspection-status--visible {
    display: flex;
}

.flight-detail-backdrop {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(4, 7, 11, 0.68);
    justify-content: center;
    align-items: center;
}

.flight-detail-popup {
    width: 680px;
    height: 780px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 17px;
    padding-bottom: 18px;
    background-color: rgb(23, 28, 35);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(69, 84, 104);
    border-right-color: rgb(69, 84, 104);
    border-top-color: rgb(69, 84, 104);
    border-bottom-color: rgb(69, 84, 104);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.flight-detail-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 13px;
    padding-bottom: 11px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.14);
}

.flight-detail-heading {
    flex-grow: 1;
}

.flight-detail-title {
    color: white;
    font-size: 22px;
    -unity-font-style: bold;
}

.flight-detail-subtitle {
    color: rgba(255, 255, 255, 0.62);
    font-size: 13px;
    margin-top: 3px;
}

.flight-detail-close {
    width: 74px;
    height: 30px;
    background-color: rgba(255, 255, 255, 0.09);
    color: white;
    border-width: 0;
}

.flight-detail-scroll {
    height: 670px;
    flex-shrink: 0;
}

.flight-detail-content {
    padding-right: 7px;
}

.flight-detail-section {
    flex-shrink: 0;
    min-height: 68px;
    margin-bottom: 14px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(255, 255, 255, 0.055);
}

.flight-detail-section-title {
    height: 18px;
    flex-shrink: 0;
    color: rgb(132, 181, 243);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 7px;
}

.flight-detail-line {
    min-height: 19px;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 13px;
    margin-bottom: 4px;
    white-space: normal;
}

.flight-detail-route-row {
    min-height: 47px;
    flex-shrink: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    margin-bottom: 3px;
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    white-space: normal;
}

.flight-detail-route-row--current {
    border-left-color: rgb(75, 150, 241);
    background-color: rgba(75, 150, 241, 0.12);
    color: white;
}

.campaign-air-empty {
    color: rgba(255, 255, 255, 0.52);
    font-size: 11px;
    margin-bottom: 5px;
    white-space: normal;
}

.campaign-hud-title {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.campaign-hud-text {
    color: white;
    font-size: 13px;
    margin-bottom: 6px;
}

.campaign-hud-selection {
    white-space: normal;
}

.campaign-hud-button {
    height: 28px;
    margin-top: 10px;
    background-color: rgb(54, 86, 142);
    color: white;
    border-width: 0;
}

.campaign-hud-button:hover {
    background-color: rgb(70, 108, 174);
}

.campaign-hud-button:active {
    background-color: rgb(38, 63, 109);
}

.campaign-hud-foldout {
    color: white;
    font-size: 13px;
}

.campaign-hud-foldout > .unity-foldout__toggle {
    color: white;
}

.campaign-hud-neighbors-list {
    flex-direction: column;
    margin-left: 8px;
    margin-top: 4px;
}

.campaign-hud-neighbor-item {
    height: 24px;
    margin-bottom: 2px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: rgba(255, 255, 255, 0.06);
    color: white;
    font-size: 12px;
    border-width: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.campaign-hud-neighbor-item:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.campaign-hud-neighbor-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
    margin-bottom: 2px;
    white-space: normal;
}

.campaign-hud-units-list {
    flex-direction: column;
    margin-left: 8px;
    margin-top: 4px;
}

.campaign-hud-unit-card {
    flex-direction: column;
    margin-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 5px;
    padding-bottom: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    border-left-width: 3px;
    border-left-color: rgb(160, 170, 185);
}

.campaign-hud-unit-name {
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.campaign-hud-unit-stat {
    color: rgba(255, 255, 255, 0.78);
    font-size: 11px;
    margin-top: 2px;
}
