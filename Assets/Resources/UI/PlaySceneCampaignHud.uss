:root {
    --bg: rgb(14, 18, 24);
    --panel: rgba(21, 27, 35, 0.96);
    --panel-2: rgb(29, 37, 47);
    --line: rgb(61, 75, 91);
    --text: rgb(230, 235, 241);
    --muted: rgb(147, 160, 176);
    --blue: rgb(67, 126, 207);
    --red: rgb(190, 69, 65);
    --amber: rgb(221, 170, 67);
}

.workbench {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--text);
}

.workbench-topbar {
    height: 58px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 14px;
    background-color: var(--panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.workbench-brand {
    width: 420px;
}

.workbench-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: white;
}

.workbench-time {
    margin-top: 2px;
    font-size: 11px;
    color: var(--muted);
}

.simulation-controls {
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: var(--line);
    border-right-color: var(--line);
}

.simulation-state-label {
    width: 148px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.7px;
    color: rgb(111, 205, 137);
}

.simulation-state-label--paused {
    color: var(--amber);
}

.workbench-button {
    height: 30px;
    min-width: 84px;
    margin-left: 6px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgb(42, 52, 65);
    color: var(--text);
}

.workbench-button:hover {
    background-color: rgb(56, 69, 86);
}

.workbench-button--primary {
    background-color: rgb(48, 92, 153);
}

.simulation-speed-button {
    min-width: 58px;
    color: var(--muted);
    font-size: 9px;
    -unity-font-style: bold;
}

.simulation-speed-button--selected {
    border-color: rgb(76, 137, 220);
    background-color: rgb(48, 92, 153);
    color: white;
}

.workbench-button--quiet {
    min-width: 98px;
    background-color: transparent;
}

.workbench-button--small {
    min-width: 52px;
    height: 26px;
    font-size: 10px;
}

.diagnostic-strip {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.diagnostic-strip-label {
    margin-right: 7px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

.diagnostic-chip {
    height: 26px;
    min-width: 84px;
    margin-left: 4px;
    border-width: 1px;
    background-color: transparent;
    font-size: 10px;
}

.diagnostic-chip--error {
    border-color: rgb(143, 62, 62);
    color: rgb(244, 151, 145);
}

.diagnostic-chip--warning {
    border-color: rgb(139, 108, 47);
    color: rgb(236, 195, 104);
}

.workbench-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 58px;
    bottom: 0;
    flex-direction: row;
}

.workbench-nav {
    position: relative;
    width: 84px;
    flex-shrink: 0;
    padding-top: 10px;
    background-color: rgba(17, 22, 29, 0.97);
    border-right-width: 1px;
    border-right-color: var(--line);
}

.workbench-nav-button {
    height: 54px;
    margin: 0 6px 6px 6px;
    padding: 4px;
    border-width: 0;
    background-color: transparent;
    color: var(--muted);
    font-size: 9px;
    white-space: normal;
}

.workbench-nav-button:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

.workbench-nav-button--selected {
    background-color: rgb(43, 66, 94);
    color: white;
    border-left-width: 3px;
    border-left-color: rgb(91, 159, 239);
}

.workbench-nav-button--utility {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 8px;
}

.workbench-panel {
    position: relative;
    width: 438px;
    height: 100%;
    flex-shrink: 0;
    background-color: var(--panel);
    border-right-width: 1px;
    border-right-color: var(--line);
}

.panel-resize-handle {
    position: absolute;
    right: -4px;
    top: 0;
    bottom: 0;
    width: 8px;
    background-color: rgba(87, 111, 139, 0.22);
}

.panel-resize-handle:hover {
    background-color: rgba(102, 159, 222, 0.65);
}

.workbench-panel-header {
    height: 62px;
    flex-shrink: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 14px;
    padding-right: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.workbench-kicker {
    color: rgb(107, 166, 239);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.workbench-panel-title {
    margin-top: 2px;
    color: white;
    font-size: 17px;
    -unity-font-style: bold;
}

.workbench-page {
    flex-grow: 1;
}

.workbench-page--hidden,
.campaign-air-list--hidden,
.campaign-air-alliance-filter--hidden {
    display: none;
}

.workbench-scroll {
    flex-grow: 1;
    padding: 12px 11px 16px 13px;
}

.workbench-scroll--nested {
    padding-top: 4px;
}

.workbench-scroll .unity-scroll-view__vertical-scroller,
.floating-window-scroll .unity-scroll-view__vertical-scroller {
    width: 14px;
    background-color: rgba(0, 0, 0, 0.30);
}

.workbench-scroll .unity-base-slider__dragger,
.floating-window-scroll .unity-base-slider__dragger {
    min-height: 36px;
    background-color: rgb(85, 109, 138);
}

.selection-summary,
.workbench-summary {
    flex-shrink: 0;
    margin-bottom: 10px;
    padding: 10px;
    background-color: rgba(255, 255, 255, 0.055);
    color: var(--text);
    font-size: 12px;
    white-space: normal;
}

.workbench-foldout {
    flex-shrink: 0;
    margin-bottom: 5px;
    color: var(--text);
    font-size: 12px;
}

.workbench-foldout > .unity-foldout__toggle {
    color: var(--text);
}

.dense-list {
    flex-shrink: 0;
    margin-top: 5px;
    margin-bottom: 8px;
}

.stat-grid {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 10px;
}

.stat-tile {
    flex-grow: 1;
    align-items: center;
    margin-right: 5px;
    padding-top: 7px;
    padding-bottom: 6px;
    background-color: var(--panel-2);
}

.stat-value {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
}

.stat-label {
    color: var(--muted);
    font-size: 8px;
    letter-spacing: 0.8px;
}

.air-overview-grid {
    flex-shrink: 0;
}

.segmented-control {
    height: 34px;
    flex-shrink: 0;
    flex-direction: row;
    margin-bottom: 8px;
}

.segment {
    flex-grow: 1;
    height: 30px;
    margin-right: 4px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgb(35, 43, 54);
    color: var(--muted);
    font-size: 10px;
}

.segment--selected,
.campaign-air-view-tab--selected {
    background-color: rgb(48, 92, 153);
    color: white;
}

.segment--blue.campaign-air-alliance-tab--selected {
    background-color: rgb(45, 96, 166);
    color: white;
}

.segment--red.campaign-air-alliance-tab--selected {
    background-color: rgb(139, 53, 52);
    color: white;
}

.table-title {
    margin-top: 3px;
    margin-bottom: 5px;
    color: var(--muted);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.inspection-status {
    display: none;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 7px;
    background-color: rgba(161, 120, 38, 0.22);
    color: rgb(238, 205, 129);
    font-size: 10px;
    white-space: normal;
}

.campaign-air-inspection-status--visible {
    display: flex;
}

.campaign-air-card {
    min-height: 0;
    flex-shrink: 0;
    margin-bottom: 4px;
    padding: 7px 8px 6px 9px;
    background-color: rgba(255, 255, 255, 0.052);
    border-left-width: 3px;
    border-left-color: rgb(123, 135, 151);
}

.campaign-air-card--clickable {
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    -unity-text-align: middle-left;
}

.campaign-air-card--clickable:hover {
    background-color: rgba(77, 126, 190, 0.21);
}

.campaign-air-card--blue {
    border-left-color: rgb(72, 136, 226);
}

.campaign-air-card--red {
    border-left-color: rgb(211, 73, 68);
}

.campaign-air-card-title {
    min-height: 20px;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}

.campaign-air-field-row {
    min-height: 18px;
    flex-shrink: 0;
    flex-direction: row;
}

.campaign-air-field-label {
    width: 105px;
    flex-shrink: 0;
    color: rgb(126, 140, 157);
    font-size: 10px;
}

.campaign-air-field-value {
    flex-grow: 1;
    color: rgb(210, 218, 228);
    font-size: 10px;
    white-space: normal;
}

.campaign-air-empty,
.campaign-hud-neighbor-label {
    color: var(--muted);
    font-size: 10px;
    white-space: normal;
}

.campaign-hud-neighbor-item {
    min-height: 25px;
    margin-bottom: 3px;
    padding-left: 7px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text);
    font-size: 10px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.campaign-hud-unit-card {
    margin-bottom: 4px;
    padding: 6px 7px;
    background-color: rgba(255, 255, 255, 0.055);
    border-left-width: 3px;
}

.campaign-hud-unit-name {
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}

.campaign-hud-unit-stat {
    margin-top: 2px;
    color: rgb(177, 188, 201);
    font-size: 9px;
    white-space: normal;
}

.overlay-palette {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 190px;
    padding: 10px 11px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
}

.perspective-controls {
    height: 30px;
    flex-direction: row;
    margin-top: 5px;
    margin-bottom: 10px;
}

.perspective-button {
    flex-grow: 1;
    height: 26px;
    min-width: 0;
    margin-right: 3px;
    padding-left: 4px;
    padding-right: 4px;
    border-width: 1px;
    border-color: var(--line);
    background-color: rgb(35, 43, 54);
    color: var(--muted);
    font-size: 9px;
}

.perspective-button--selected {
    background-color: rgb(66, 74, 86);
    border-color: rgb(178, 190, 205);
    color: white;
}

.perspective-button--blue.perspective-button--selected {
    background-color: rgb(45, 96, 166);
    border-color: rgb(82, 148, 231);
}

.perspective-button--red.perspective-button--selected {
    background-color: rgb(139, 53, 52);
    border-color: rgb(214, 92, 86);
}

.overlay-toggle {
    height: 25px;
    color: var(--text);
    font-size: 10px;
}

.filter-row {
    flex-shrink: 0;
    padding: 9px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.filter-search,
.filter-dropdown {
    margin-bottom: 5px;
    color: var(--text);
    font-size: 10px;
}

.window-layer,
.floating-window-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.floating-window-host {
    display: none;
}

.floating-window {
    position: absolute;
    left: 670px;
    top: 120px;
    width: 650px;
    height: 780px;
    background-color: rgb(22, 28, 36);
    border-width: 1px;
    border-color: rgb(82, 101, 124);
}

.floating-window-header {
    height: 66px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 8px;
    background-color: rgb(31, 40, 51);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.floating-window-heading {
    flex-grow: 1;
}

.floating-window-title {
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
}

.floating-window-subtitle {
    margin-top: 1px;
    color: var(--muted);
    font-size: 10px;
}

.window-close {
    width: 30px;
    height: 26px;
    margin-left: 5px;
    border-width: 0;
    background-color: rgb(112, 48, 48);
    color: white;
    font-size: 16px;
}

.floating-window-scroll {
    flex-grow: 1;
    padding: 10px 10px 12px 12px;
}

.window-resize-handle {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 18px;
    height: 18px;
    background-color: rgb(80, 99, 122);
}

.flight-detail-section {
    min-height: 0;
    flex-shrink: 0;
    margin-bottom: 8px;
    padding: 8px 9px;
    background-color: rgba(255, 255, 255, 0.05);
}

.flight-detail-section-title {
    margin-bottom: 5px;
    color: rgb(116, 175, 244);
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.flight-detail-line,
.flight-detail-route-row {
    min-height: 18px;
    margin-bottom: 3px;
    color: rgb(208, 217, 228);
    font-size: 10px;
    white-space: normal;
}

.flight-detail-route-row {
    padding: 5px 6px;
    border-left-width: 2px;
    border-left-color: rgb(81, 95, 112);
}

.flight-detail-route-row--current {
    border-left-color: rgb(78, 151, 239);
    background-color: rgba(78, 151, 239, 0.12);
}
